<?php
session_start();
if (!isset($_SESSION['user_id'])) {
    header("Location: login.php");
    exit;
}
require_once 'db_config.php';

$donut_search = $_GET['donut_search'] ?? '';
if ($donut_search !== '') {
    $donuts_stmt = $pdo->prepare("SELECT d.*, u.username AS creator FROM donuts d LEFT JOIN users u ON d.added_by = u.user_id WHERE d.donut_name LIKE :search");
    $donuts_stmt->execute([':search' => "%$donut_search%"]);
} else {
    $donuts_stmt = $pdo->query("SELECT d.*, u.username AS creator FROM donuts d LEFT JOIN users u ON d.added_by = u.user_id");
}
$donuts = $donuts_stmt->fetchAll();

$ing_search = $_GET['ing_search'] ?? '';
if ($ing_search !== '') {
    $ing_stmt = $pdo->prepare("SELECT i.*, d.donut_name, u.username AS creator FROM ingredients i 
                               JOIN donuts d ON i.donut_id = d.donut_id 
                               LEFT JOIN users u ON i.added_by = u.user_id
                               WHERE i.ingredient_name LIKE :search OR d.donut_name LIKE :search");
    $ing_stmt->execute([':search' => "%$ing_search%"]);
} else {
    $ing_stmt = $pdo->query("SELECT i.*, d.donut_name, u.username AS creator FROM ingredients i 
                             JOIN donuts d ON i.donut_id = d.donut_id 
                             LEFT JOIN users u ON i.added_by = u.user_id");
}
$ingredients = $ing_stmt->fetchAll();
